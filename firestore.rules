rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email in [
            'goodluckbello85@gmail.com',
            'info@getrobotics.com'
          ]
          || (
            exists(/databases/$(database)/documents/getrobotics_settings/admins)
            && get(/databases/$(database)/documents/getrobotics_settings/admins).data.emails is list
            && request.auth.token.email in get(/databases/$(database)/documents/getrobotics_settings/admins).data.emails
          )
        );
    }

    function validOrderLine(item) {
        return item is map
          && item.keys().hasAll(['id', 'sku', 'title', 'quantity', 'unitPrice', 'selarUrl'])
          && item.keys().hasOnly(['id', 'sku', 'title', 'quantity', 'unitPrice', 'selarUrl'])
          && item.id is string
          && item.id.matches('GET-[A-Z0-9-]{1,44}')
          && item.id == item.sku
          && item.sku is string
          && item.title is string
          && item.title.size() > 0
          && item.title.size() <= 160
          && item.quantity is int
          && item.quantity > 0
          && item.quantity <= 99
          && item.unitPrice is number
          && item.selarUrl is string
          && item.selarUrl.size() <= 2048
          && exists(/databases/$(database)/documents/getrobotics_products/$(item.id))
          && get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data.price is number
          && item.unitPrice == get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data.price
          && item.sku == get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data.sku
          && item.title == get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data.title
          && (
            (!('selarUrl' in get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data)
              && item.selarUrl == '')
            || (
              'selarUrl' in get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data
              && item.selarUrl == get(/databases/$(database)/documents/getrobotics_products/$(item.id)).data.selarUrl
            )
          );
    }

    function validOrderItems(items) {
        return items is list
          && items.size() > 0
          && items.size() <= 10
          && validOrderLine(items[0])
          && (items.size() <= 1 || validOrderLine(items[1]))
          && (items.size() <= 2 || validOrderLine(items[2]))
          && (items.size() <= 3 || validOrderLine(items[3]))
          && (items.size() <= 4 || validOrderLine(items[4]))
          && (items.size() <= 5 || validOrderLine(items[5]))
          && (items.size() <= 6 || validOrderLine(items[6]))
          && (items.size() <= 7 || validOrderLine(items[7]))
          && (items.size() <= 8 || validOrderLine(items[8]))
          && (items.size() <= 9 || validOrderLine(items[9]));
    }

    function orderTotal(items) {
        return (items.size() > 0 ? items[0].unitPrice * items[0].quantity : 0)
          + (items.size() > 1 ? items[1].unitPrice * items[1].quantity : 0)
          + (items.size() > 2 ? items[2].unitPrice * items[2].quantity : 0)
          + (items.size() > 3 ? items[3].unitPrice * items[3].quantity : 0)
          + (items.size() > 4 ? items[4].unitPrice * items[4].quantity : 0)
          + (items.size() > 5 ? items[5].unitPrice * items[5].quantity : 0)
          + (items.size() > 6 ? items[6].unitPrice * items[6].quantity : 0)
          + (items.size() > 7 ? items[7].unitPrice * items[7].quantity : 0)
          + (items.size() > 8 ? items[8].unitPrice * items[8].quantity : 0)
          + (items.size() > 9 ? items[9].unitPrice * items[9].quantity : 0);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'fullName', 'displayName', 'email', 'phone', 'createdAt',
          'cart', 'wishlist', 'updatedAt'
        ]);
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    match /getrobotics_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /getrobotics_videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /getrobotics_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /getrobotics_settings/{settingsId} {
      allow get: if settingsId != 'admins'
        || (
          request.auth != null
          && request.auth.token.email_verified == true
        );
      allow list: if settingsId != 'admins';
      allow write: if isAdmin();
    }

    match /getrobotics_orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'orderId', 'customer', 'items', 'total', 'currency', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderId', 'customer', 'items', 'total', 'currency', 'status', 'createdAt'
        ])
        && request.resource.data.orderId == orderId
        && orderId.matches('GET-ORD-[A-Z0-9-]+')
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasAll(['name', 'phone', 'address'])
        && request.resource.data.customer.keys().hasOnly(['name', 'phone', 'address'])
        && request.resource.data.customer.name is string
        && request.resource.data.customer.name.size() > 0
        && request.resource.data.customer.name.size() <= 120
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.size() > 0
        && request.resource.data.customer.phone.size() <= 40
        && request.resource.data.customer.address is string
        && request.resource.data.customer.address.size() > 0
        && request.resource.data.customer.address.size() <= 500
        && validOrderItems(request.resource.data.items)
        && request.resource.data.total is number
        && request.resource.data.total == orderTotal(request.resource.data.items)
        && request.resource.data.currency == 'NGN'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }

    match /getrobotics_inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'program', 'message', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.program is string
        && request.resource.data.program.size() > 0
        && request.resource.data.program.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
